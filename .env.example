# Copy this file to .env and adjust. Never commit the real .env file.

# Port the web server listens on
PORT=3000
# Interface to listen on (0.0.0.0 = all network interfaces, e.g. on the school network)
HOST=0.0.0.0

# Where the SQLite database file is stored. Back this file up regularly.
DATABASE_FILE=./data/school.db

# Set to production when the site is served over HTTPS (makes login cookies HTTPS-only)
NODE_ENV=development
# Set to 1 if the site runs behind a reverse proxy (Caddy, Nginx, a hosting platform)
TRUST_PROXY=0
# Force secure cookies even outside production (1 = yes)
COOKIE_SECURE=0

# How many days a login stays valid
SESSION_DAYS=7
