# Copy this file to .env and adjust. Never commit the real .env file.

# Port the web server listens on
PORT=3000
# Interface to listen on (0.0.0.0 = all network interfaces, e.g. on the school network)
HOST=0.0.0.0

# Where the SQLite database file is stored. Back this file up regularly.
DATABASE_FILE=./data/school.db

# Set to production when the site is served over HTTPS (makes login cookies HTTPS-only)
NODE_ENV=development
# Set to 1 ONLY when the site runs behind exactly one reverse proxy (Caddy, Nginx, a hosting
# platform's load balancer). The proxy then supplies each visitor's real address, which the
# sign-in limits rely on. With 1, also set HOST=127.0.0.1 so visitors cannot bypass the proxy
# and send a fake address. Leave 0 when visitors connect to the app directly.
TRUST_PROXY=0
# Force secure cookies even outside production (1 = yes)
COOKIE_SECURE=0

# How many days a login stays valid (teachers, parents, students; see the idle limits below)
SESSION_DAYS=7

# --- Sign-in timeouts (minutes without any activity before a sign-in ends) ---
IDLE_MINUTES_ADMIN=30
IDLE_MINUTES_BURSAR=30
IDLE_MINUTES_TEACHER=240
IDLE_MINUTES_PARENT=120
IDLE_MINUTES_STUDENT=60
# Longest an administrator or bursar sign-in can last, even when active (hours)
SESSION_MAX_HOURS_PRIVILEGED=12

# --- Backups ---
# Folder for backup copies (default: a "backups" folder next to the database file)
# BACKUP_DIR=./data/backups
# Hours between automatic backups while the server runs (0 = off, at most 168)
BACKUP_INTERVAL_HOURS=24
# How many automatic copies to keep
BACKUP_KEEP=14

# --- Logs: debug, info, warn, error or silent. Logs are one JSON object per line.
LOG_LEVEL=info

# HTTPS-only reminder sent to browsers in production (seconds; 0 = off). Default 180 days.
# HSTS_MAX_AGE=15552000

# The server refuses to start in production on a DEMO database. Set to 1 only for a public
# demonstration site with fictional data.
ALLOW_DEMO_IN_PRODUCTION=0
