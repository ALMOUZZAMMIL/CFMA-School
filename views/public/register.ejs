<%- include('../partials/public-head') %>
<section class="auth-wrap auth-wide">
  <div class="auth-card">
    <h1><%= t('access.requestTitle') %></h1>
    <p class="muted"><%= t('access.requestIntro') %></p>
    <ol class="mini-steps small" aria-label="<%= t('site.howTitle') %>">
      <li><%= t('site.how1Title') %></li><li><%= t('site.how2Title') %></li><li><%= t('site.how3Title') %></li>
    </ol>
    <%- include('../partials/errors', { errors }) %>
    <form method="post" action="/register" class="form" data-once data-loading novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="hp" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off"></div>

      <fieldset>
        <legend><%= t('access.iAm') %></legend>
        <div class="choice-row">
          <% roles.forEach(function (r) { %>
          <label class="choice"><input type="radio" name="role_requested" value="<%= r %>" <%= values.role_requested === r ? 'checked' : '' %> required>
            <span><strong><%= t('access.as.' + r) %></strong><br><small><%= t('access.asHelp.' + r) %></small></span></label>
          <% }) %>
        </div>
        <p class="help"><%= t('access.staffNote') %></p>
      </fieldset>

      <div class="grid-2">
        <div><label for="full_name"><%= t('fields.full_name') %></label>
          <input id="full_name" name="full_name" value="<%= values.full_name || '' %>" required maxlength="120" autocomplete="name" <%- errors.some(function (e) { return e.field === 'full_name'; }) ? 'aria-invalid="true"' : '' %>></div>
        <div><label for="phone"><%= t('fields.phone') %></label>
          <input id="phone" name="phone" type="tel" value="<%= values.phone || '' %>" required placeholder="+237 6XX XX XX XX" autocomplete="tel" <%- errors.some(function (e) { return e.field === 'phone'; }) ? 'aria-invalid="true"' : '' %>></div>
        <div><label for="email"><%= t('fields.email') %> <span class="help-inline">(<%= t('common.optional') %>)</span></label>
          <input id="email" name="email" type="email" value="<%= values.email || '' %>" autocomplete="email" <%- errors.some(function (e) { return e.field === 'email'; }) ? 'aria-invalid="true"' : '' %>></div>
        <div><label for="language"><%= t('fields.language') %></label>
          <select id="language" name="language"><option value="fr">Français</option><option value="en" <%= values.language === 'en' ? 'selected' : '' %>>English</option></select></div>
      </div>

      <label for="details"><%= t('fields.details') %></label>
      <textarea id="details" name="details" rows="3" maxlength="1000" required aria-describedby="details-help" <%- errors.some(function (e) { return e.field === 'details'; }) ? 'aria-invalid="true"' : '' %>><%= values.details || '' %></textarea>
      <p id="details-help" class="help"><%= t('access.detailsHelp') %></p>

      <label class="check"><input type="checkbox" name="confirm" value="1" <%= values.confirm ? 'checked' : '' %> required> <%= t('access.confirmText') %></label>
      <div class="alert alert-info small" role="note"><span class="alert-icon" aria-hidden="true">i</span> <%= t('access.noPasswordNote') %></div>
      <button class="btn btn-primary btn-lg" data-loading-text="<%= t('access.sending') %>"><%= t('access.send') %></button>
    </form>
    <p class="auth-alt"><%= t('site.haveAccount') %> <a href="/login"><%= t('auth.login') %></a></p>
  </div>
</section>
<%- include('../partials/public-foot') %>
