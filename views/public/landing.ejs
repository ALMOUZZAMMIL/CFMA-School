<%# Welcome page, "modern" layout: a fixed sign-in panel on the left, and the presentation
    of the portal as coloured blocks on the right. On phones the panel comes first. %>
<%- include('../partials/public-head', { split: true }) %>
<% const canRequest = settings.allow_account_requests === '1'; %>
<aside class="split-side" aria-labelledby="signin-title">
  <a class="split-brand" href="/">
    <span class="split-logo"><%- include('../partials/mark', { size: 'md' }) %></span>
    <span class="split-brand-text"><strong><%= settings.school_name %></strong><span><%= settings.school_motto || t('site.platformName') %></span></span>
  </a>

  <div class="split-signin">
    <h1 id="signin-title" class="split-title"><%= t('site.welcomeBack') %></h1>
    <p class="split-lead"><%= t('site.signinShort') %></p>
    <form method="post" action="/login" class="form split-form" data-once data-loading>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="/">
      <label for="username"><%= t('auth.usernameOrEmail') %></label>
      <input id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required>
      <div class="label-row"><label for="password"><%= t('fields.password') %></label><a class="small" href="/forgot-password"><%= t('access.forgotLink') %></a></div>
      <div class="pw-field">
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <button type="button" class="pw-toggle" data-pw-toggle="password" aria-controls="password" aria-pressed="false" data-show="<%= t('auth.showPassword') %>" data-hide="<%= t('auth.hidePassword') %>" hidden><%= t('auth.showPassword') %></button>
      </div>
      <button class="btn btn-accent btn-block btn-lg" data-loading-text="<%= t('auth.signingIn') %>"><%= t('auth.login') %></button>
    </form>
    <p class="split-alt small"><%= t('site.noAccount') %> <% if (canRequest) { %><a href="/register"><%= t('access.requestTitle') %></a><% } else { %><%= t('access.askSchool') %><% } %></p>
  </div>

  <div class="split-side-foot small">
    <p>
      <% if (settings.school_address) { %><%= settings.school_address %><br><% } %>
      <% if (settings.school_email) { %><a href="mailto:<%= settings.school_email %>"><%= settings.school_email %></a><br><% } %>
      <% if (settings.school_phone) { %><a href="tel:<%= settings.school_phone.replace(/[^+\d]/g, '') %>"><%= settings.school_phone %></a><% } %>
    </p>
    <form method="post" action="/lang" class="lang-pill lang-pill-dark" aria-label="<%= t('site.language') %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="back" value="<%= originalUrl %>">
      <button name="lang" value="fr" class="<%= lang === 'fr' ? 'on' : '' %>" aria-pressed="<%= lang === 'fr' %>" lang="fr" title="Français">FR</button>
      <button name="lang" value="en" class="<%= lang === 'en' ? 'on' : '' %>" aria-pressed="<%= lang === 'en' %>" lang="en" title="English">EN</button>
    </form>
  </div>
</aside>

<main id="main" class="split-main">
  <div class="split-top">
    <span class="split-pill"><%= t('site.eyebrow') %></span>
  </div>

  <div class="bento">
    <section class="bento-card bento-hero">
      <div class="bento-hero-text">
        <h2 class="bento-hero-title"><%= t('site.heroTitle') %></h2>
        <p class="bento-hero-lead"><%= t('site.heroLead') %></p>
        <ul class="hero-points small">
          <li><span aria-hidden="true">✓</span> <%= t('site.point1') %></li>
          <li><span aria-hidden="true">✓</span> <%= t('site.point2') %></li>
          <li><span aria-hidden="true">✓</span> <%= t('site.point3') %></li>
        </ul>
      </div>
      <%# Dashboard preview: a lightweight HTML illustration with sample figures, not real data. %>
      <figure class="preview" aria-labelledby="preview-cap">
        <div class="preview-window" aria-hidden="true">
          <div class="pv-side">
            <span class="pv-side-logo"></span>
            <% ['home', 'attendance', 'progress', 'calendar', 'megaphone'].forEach(function (n, i) { %><span class="pv-side-item<%= i === 0 ? ' on' : '' %>"><%- include('../partials/icon', { name: n, cls: 'ico-sm' }) %></span><% }) %>
          </div>
          <div class="pv-main">
            <div class="pv-top"><em><%= t('site.previewTitle') %></em><span class="pv-avatar">MP</span></div>
            <div class="preview-row">
              <div class="pv-stat pv-tone-1"><span class="pv-ico"><%- include('../partials/icon', { name: 'calendar', cls: 'ico-sm' }) %></span><b>18 h</b><small><%= t('site.pvScheduled') %></small></div>
              <div class="pv-stat pv-tone-2"><span class="pv-ico"><%- include('../partials/icon', { name: 'check', cls: 'ico-sm' }) %></span><b>16 h</b><small><%= t('site.pvTaught') %></small></div>
              <div class="pv-stat pv-tone-3"><span class="pv-ico"><%- include('../partials/icon', { name: 'clock', cls: 'ico-sm' }) %></span><b>1</b><small><%= t('site.pvMakeup') %></small></div>
            </div>
            <div class="pv-card">
              <div class="pv-line"><strong>07:30 · 2nde C</strong><span class="badge badge-held">✓ <%= t('session.st.held') %></span></div>
              <div class="pv-line"><strong>10:00 · Form 4 A</strong><span class="badge badge-pending">○ <%= t('teaching.notRecorded') %></span></div>
            </div>
            <div class="pv-card">
              <div class="pv-progress-label"><span><%= t('site.pvProgress') %></span><span>9/17</span></div>
              <div class="pv-track"><span class="pv-fill"></span><span class="pv-plan"></span></div>
            </div>
          </div>
        </div>
        <figcaption id="preview-cap" class="small"><%= t('site.previewCaption') %></figcaption>
      </figure>
    </section>

    <h2 class="sr-only"><%= t('site.featuresTitle') %></h2>
    <% [['clock', 'f1'], ['book', 'f2'], ['attendance', 'f3'], ['megaphone', 'f4']].forEach(function (f, i) { %>
    <article class="bento-card bento-feature bento-tone-<%= i + 1 %>">
      <span class="bento-icon" aria-hidden="true"><%- include('../partials/icon', { name: f[0] }) %></span>
      <h3><%= t('site.' + f[1] + 'Title') %></h3>
      <p><%= t('site.' + f[1] + 'Text') %></p>
    </article>
    <% }) %>

    <section class="bento-card bento-roles" aria-labelledby="roles-title">
      <h2 id="roles-title" class="bento-h"><%= t('site.rolesTitle') %></h2>
      <div class="bento-role-grid">
        <div class="bento-role"><span class="role-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'user' }) %></span><h3><%= t('roles.teachers') %></h3><p><%= t('site.roleTeacher') %></p></div>
        <div class="bento-role"><span class="role-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'users' }) %></span><h3><%= t('roles.parents') %></h3><p><%= t('site.roleParent') %></p></div>
        <div class="bento-role"><span class="role-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'book' }) %></span><h3><%= t('roles.students') %></h3><p><%= t('site.roleStudent') %></p></div>
        <div class="bento-role"><span class="role-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'settings' }) %></span><h3><%= t('site.roleAdminTitle') %></h3><p><%= t('site.roleAdmin') %></p></div>
      </div>
    </section>

    <section class="bento-card bento-how" aria-labelledby="how-title">
      <h2 id="how-title" class="bento-h"><%= t('site.howTitle') %></h2>
      <ol class="bento-steps">
        <li><span class="how-num" aria-hidden="true">1</span><div><h3><%= t('site.how1Title') %></h3><p><%= t('site.how1Text') %></p></div></li>
        <li><span class="how-num" aria-hidden="true">2</span><div><h3><%= t('site.how2Title') %></h3><p><%= t('site.how2Text') %></p></div></li>
        <li><span class="how-num" aria-hidden="true">3</span><div><h3><%= t('site.how3Title') %></h3><p><%= t('site.how3Text') %></p></div></li>
      </ol>
    </section>

    <section class="bento-card bento-cta" aria-labelledby="cta-title">
      <h2 id="cta-title" class="bento-h"><%= t('site.noAccount') %></h2>
      <p><%= canRequest ? t('site.how1Text') : t('access.askSchool') %></p>
      <div class="bento-cta-actions">
        <% if (canRequest) { %><a class="btn btn-light btn-lg" href="/register"><%= t('site.createAccount') %></a><% } %>
        <p class="small"><%= t('site.haveAccount') %> <a href="/login"><%= t('auth.login') %></a></p>
      </div>
    </section>
  </div>

  <p class="foot-privacy small"><%= t('common.footerPrivacy') %></p>
</main>
<%- include('../partials/public-foot', { split: true }) %>
