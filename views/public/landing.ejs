<%- include('../partials/public-head') %>
<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <p class="eyebrow"><%= t('site.eyebrow') %></p>
      <h1 class="hero-title"><%= t('site.heroTitle') %></h1>
      <p class="hero-lead"><%= t('site.heroLead') %></p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/login"><%= t('auth.login') %></a>
        <% if (settings.allow_account_requests === '1') { %><a class="btn btn-lg btn-outline" href="/register"><%= t('site.createAccount') %></a><% } %>
      </div>
      <ul class="hero-points small">
        <li><span aria-hidden="true">✓</span> <%= t('site.point1') %></li>
        <li><span aria-hidden="true">✓</span> <%= t('site.point2') %></li>
        <li><span aria-hidden="true">✓</span> <%= t('site.point3') %></li>
      </ul>
    </div>

    <%# Dashboard preview: a lightweight HTML illustration with sample figures, not real data. %>
    <figure class="preview" aria-labelledby="preview-cap">
      <div class="preview-window" aria-hidden="true">
        <div class="preview-bar"><span></span><span></span><span></span><em><%= t('site.previewTitle') %></em></div>
        <div class="preview-body">
          <div class="preview-row">
            <div class="pv-stat"><b>18 h</b><small><%= t('site.pvScheduled') %></small></div>
            <div class="pv-stat"><b>16 h</b><small><%= t('site.pvTaught') %></small></div>
            <div class="pv-stat pv-warn"><b>1</b><small><%= t('site.pvMakeup') %></small></div>
          </div>
          <div class="pv-card">
            <div class="pv-line"><strong>07:30 · 2nde C</strong><span class="badge badge-held">✓ <%= t('session.st.held') %></span></div>
            <div class="pv-line"><strong>10:00 · Form 4 A</strong><span class="badge badge-pending">○ <%= t('teaching.notRecorded') %></span></div>
            <div class="pv-line"><strong>13:00 · 1ère F3</strong><span class="badge badge-present">✓ <%= t('attendance.taken') %></span></div>
          </div>
          <div class="pv-card">
            <div class="pv-progress-label"><span><%= t('site.pvProgress') %></span><span>9/17</span></div>
            <div class="pv-track"><span class="pv-fill"></span><span class="pv-plan"></span></div>
            <div class="pv-legend small"><span class="pv-dot pv-dot-fill"></span><%= t('progress.actual') %> <span class="pv-dot pv-dot-plan"></span><%= t('progress.planned') %></div>
          </div>
        </div>
      </div>
      <figcaption id="preview-cap" class="small muted"><%= t('site.previewCaption') %></figcaption>
    </figure>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    <h2 class="section-title"><%= t('site.featuresTitle') %></h2>
    <p class="section-lead"><%= t('site.featuresLead') %></p>
    <div class="features">
      <article class="feature">
        <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M8 13h3M8 17h6"/></svg></span>
        <h3><%= t('site.f1Title') %></h3><p><%= t('site.f1Text') %></p>
      </article>
      <article class="feature">
        <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2zM18 19v2H6"/><path d="M8 8h6M8 12h4"/></svg></span>
        <h3><%= t('site.f2Title') %></h3><p><%= t('site.f2Text') %></p>
      </article>
      <article class="feature">
        <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l2 2 4-4"/><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 17h8"/></svg></span>
        <h3><%= t('site.f3Title') %></h3><p><%= t('site.f3Text') %></p>
      </article>
      <article class="feature">
        <span class="feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3"/><circle cx="17" cy="9" r="2.3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M14.5 20c.2-2.4 1.6-4.3 3.5-4.3 2 0 3 1.6 3 4.3"/></svg></span>
        <h3><%= t('site.f4Title') %></h3><p><%= t('site.f4Text') %></p>
      </article>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="section-inner">
    <h2 class="section-title"><%= t('site.rolesTitle') %></h2>
    <div class="roles">
      <div class="role-card"><h3><%= t('roles.teachers') %></h3><p><%= t('site.roleTeacher') %></p></div>
      <div class="role-card"><h3><%= t('roles.parents') %></h3><p><%= t('site.roleParent') %></p></div>
      <div class="role-card"><h3><%= t('roles.students') %></h3><p><%= t('site.roleStudent') %></p></div>
      <div class="role-card"><h3><%= t('site.roleAdminTitle') %></h3><p><%= t('site.roleAdmin') %></p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    <h2 class="section-title"><%= t('site.howTitle') %></h2>
    <ol class="how">
      <li><span class="how-num" aria-hidden="true">1</span><div><h3><%= t('site.how1Title') %></h3><p><%= t('site.how1Text') %></p></div></li>
      <li><span class="how-num" aria-hidden="true">2</span><div><h3><%= t('site.how2Title') %></h3><p><%= t('site.how2Text') %></p></div></li>
      <li><span class="how-num" aria-hidden="true">3</span><div><h3><%= t('site.how3Title') %></h3><p><%= t('site.how3Text') %></p></div></li>
    </ol>
    <div class="cta-band">
      <p><strong><%= t('site.ctaTitle') %></strong><br><span class="small"><%= t('site.ctaText') %></span></p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/login"><%= t('auth.login') %></a>
        <% if (settings.allow_account_requests === '1') { %><a class="btn btn-outline" href="/register"><%= t('site.createAccount') %></a><% } %>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/public-foot') %>
