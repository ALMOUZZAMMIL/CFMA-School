<%- include('../partials/head') %>
<div class="page-head"><h1><%= ar.kind === 'account' ? t('requests.accountRequest') : t('requests.passwordReset') %></h1><a class="btn" href="/admin/requests"><%= t('common.back') %></a></div>
<section class="card">
  <dl class="dl">
    <dt><%= t('common.when') %></dt><dd><%= fmt.dateTime(ar.created_at) %></dd>
    <dt><%= t('attendance.status') %></dt><dd><%- include('../partials/badge', { kind: 'requests', value: ar.status }) %><% if (ar.handled_by_name) { %> · <%= ar.handled_by_name %>, <%= fmt.dateTime(ar.handled_at) %><% } %></dd>
    <% if (ar.kind === 'account') { %>
      <dt><%= t('requests.type') %></dt><dd><%= t('access.as.' + ar.role_requested) %></dd>
      <dt><%= t('fields.full_name') %></dt><dd><%= ar.full_name %></dd>
    <% } else { %>
      <dt><%= t('fields.identifier') %></dt><dd><code><%= ar.identifier %></code></dd>
    <% } %>
    <dt><%= t('fields.phone') %></dt><dd><%= ar.phone || '—' %></dd>
    <% if (ar.email) { %><dt><%= t('fields.email') %></dt><dd><%= ar.email %></dd><% } %>
    <dt><%= t('fields.language') %></dt><dd><%= ar.language === 'en' ? 'English' : 'Français' %></dd>
    <% if (ar.details) { %><dt><%= t('fields.details') %></dt><dd class="pre"><%= ar.details %></dd><% } %>
    <% if (ar.admin_note) { %><dt><%= t('requests.note') %></dt><dd><%= ar.admin_note %></dd><% } %>
  </dl>
</section>

<% if (ar.status === 'pending') { %>
<div class="alert alert-info" role="note"><span class="alert-icon" aria-hidden="true">!</span> <%= ar.kind === 'account' ? t('requests.verifyFirst') : t('requests.verifyReset') %></div>

<% if (ar.kind === 'account') { %>
<section class="card">
  <h2><%= t('requests.approveTitle') %></h2>
  <%- include('../partials/errors', { errors }) %>
  <form method="post" action="/admin/requests/<%= ar.id %>/approve" class="form" data-once>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid-2">
      <div><label for="role"><%= t('fields.role') %></label><select id="role" name="role"><% ['parent','teacher','student'].forEach(function (r) { %><option value="<%= r %>" <%= values.role === r ? 'selected' : '' %>><%= t('roles.' + r) %></option><% }) %></select>
        <p class="help"><%= t('requests.roleHelp') %></p></div>
      <div><label for="username"><%= t('fields.username') %></label><input id="username" name="username" value="<%= values.username %>" required pattern="[A-Za-z0-9._\-]{3,40}" autocapitalize="none"></div>
      <div><label for="full_name"><%= t('fields.full_name') %></label><input id="full_name" name="full_name" value="<%= values.full_name || '' %>" required maxlength="120"></div>
      <div><label for="phone"><%= t('fields.phone') %></label><input id="phone" name="phone" type="tel" value="<%= values.phone || '' %>"></div>
      <div><label for="email"><%= t('fields.email') %></label><input id="email" name="email" type="email" value="<%= values.email || '' %>"></div>
      <div><label for="language"><%= t('fields.language') %></label><select id="language" name="language"><option value="fr">Français</option><option value="en" <%= values.language === 'en' ? 'selected' : '' %>>English</option></select></div>
    </div>
    <fieldset class="subcard">
      <legend><%= t('requests.linkStudent') %></legend>
      <p class="help"><%= t('requests.linkStudentHelp') %></p>
      <div class="grid-2">
        <div><label for="student_id"><%= t('students.name') %></label>
          <select id="student_id" name="student_id"><option value=""><%= t('requests.noLinkNow') %></option>
            <% students.forEach(function (s) { %><option value="<%= s.id %>" <%= String(values.student_id) === String(s.id) ? 'selected' : '' %>><%= s.class_name %> · <%= s.full_name %> (<%= s.student_number %>)<%= s.user_id ? ' · ' + t('requests.hasLogin') : '' %></option><% }) %>
          </select></div>
        <div><label for="relationship"><%= t('fields.relationship') %></label><input id="relationship" name="relationship" value="<%= values.relationship || '' %>" maxlength="40"></div>
      </div>
    </fieldset>
    <button class="btn btn-primary" data-confirm="<%= t('requests.confirmApprove') %>"><%= t('requests.approve') %></button>
  </form>
</section>
<% } else { %>
<section class="card">
  <h2><%= t('requests.matchingAccounts') %></h2>
  <% if (!matches.length) { %><p class="muted"><%= t('requests.noMatch') %></p><% } else { %>
  <ul class="list"><% matches.forEach(function (m) { %><li><a href="/admin/users/<%= m.id %>"><%= m.full_name %></a> · <code><%= m.username %></code> · <%= t('roles.' + m.role) %><%= m.phone ? ' · ' + m.phone : '' %><%= m.active ? '' : ' · ' + t('common.inactive') %>
    <form method="post" action="/admin/users/<%= m.id %>/reset-password" class="inline" data-confirm="<%= t('admin.confirmReset') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-small"><%= t('admin.resetPassword') %></button></form></li><% }) %></ul>
  <% } %>
  <p class="help"><%= t('requests.resetHelp') %></p>
  <form method="post" action="/admin/requests/<%= ar.id %>/done" class="row-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label><%= t('requests.note') %><input name="admin_note" maxlength="500"></label><button class="btn btn-primary btn-small"><%= t('requests.markDone') %></button></form>
</section>
<% } %>

<section class="card">
  <h2><%= t('requests.rejectTitle') %></h2>
  <form method="post" action="/admin/requests/<%= ar.id %>/reject" class="row-form" data-confirm="<%= t('requests.confirmReject') %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label><%= t('requests.note') %><input name="admin_note" maxlength="500" placeholder="<%= t('requests.rejectPlaceholder') %>"></label><button class="btn btn-small linkbtn danger"><%= t('requests.reject') %></button></form>
</section>
<% } %>
<%- include('../partials/foot') %>
