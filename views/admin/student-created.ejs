<%- include('../partials/head') %>
<section class="narrow card">
  <h1><%= t('admin.accountCreated') %></h1>
  <div class="alert alert-ok credentials" role="status">
    <p><%= created.full_name %></p>
    <p><%= t('fields.username') %>: <code><%= created.username %></code><br><%= t('admin.tempPassword') %>: <code><%= created.password %></code></p>
  </div>
  <p class="help"><%= t('admin.tempPasswordHelp') %></p>
  <% if (created.parent && !created.id) { %><p class="help"><%= t('requests.linkChildrenNext') %></p><% } %>
  <p><button class="btn" data-print><%= t('common.print') %></button>
    <% if (created.id) { %><a class="btn btn-primary" href="/admin/students/<%= created.id %>"><%= t('common.continue') %></a>
    <% } else if (created.userId) { %><a class="btn btn-primary" href="/admin/users/<%= created.userId %>"><%= t('common.continue') %></a><% } %>
    <a class="btn" href="/admin/requests"><%= t('requests.backToList') %></a></p>
</section>
<%- include('../partials/foot') %>
