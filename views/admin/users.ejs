<%- include('../partials/head') %>
<h1><%= t('admin.users') %></h1>
<% if (created) { %>
<div class="alert alert-ok credentials" role="status">
  <p><strong><%= t('admin.accountCreated') %></strong></p>
  <p><%= t('fields.username') %>: <code><%= created.username %></code> · <%= t('admin.tempPassword') %>: <code><%= created.password %></code></p>
  <p class="small"><%= t('admin.tempPasswordHelp') %></p>
</div>
<% } %>
<form method="get" class="filters">
  <label><%= t('fields.role') %><select name="role"><option value=""><%= t('common.all') %></option><% roles.forEach(function (r) { %><option value="<%= r %>" <%= role === r ? 'selected' : '' %>><%= t('roles.' + r) %></option><% }) %></select></label>
  <label><%= t('common.search') %><input name="q" value="<%= q %>"></label><button class="btn"><%= t('common.show') %></button>
</form>
<% if (!rows.length) { %><div class="empty"><p><%= t('admin.noUsers') %></p></div><% } else { %>
<div class="table-wrap"><table>
  <thead><tr><th><%= t('fields.full_name') %></th><th><%= t('fields.username') %></th><th><%= t('fields.role') %></th><th><%= t('attendance.status') %></th><th><%= t('admin.lastLogin') %></th></tr></thead>
  <tbody><% rows.forEach(function (u) { %><tr><td><a href="/admin/users/<%= u.id %>"><%= u.full_name %></a></td><td><%= u.username %></td><td><%= t('roles.' + u.role) %></td>
    <td><% if (!u.active) { %><span class="badge badge-cancelled"><span aria-hidden="true">⊘</span> <%= t('common.inactive') %></span><% } else if (u.must_change_password) { %><span class="badge badge-planned"><span aria-hidden="true">◷</span> <%= t('admin.awaitingFirstLogin') %></span><% } else { %><span class="badge badge-held"><span aria-hidden="true">✓</span> <%= t('common.active') %></span><% } %></td>
    <td class="small"><%= u.last_login_at ? fmt.dateTime(u.last_login_at) : '—' %></td></tr><% }) %></tbody>
</table></div>
<% } %>
<section class="card">
  <h2><%= t('admin.addUser') %></h2>
  <p class="help"><%= t('admin.addUserHelp') %></p>
  <%- include('../partials/errors', { errors }) %>
  <form method="post" action="/admin/users" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid-2">
      <div><label for="full_name"><%= t('fields.full_name') %></label><input id="full_name" name="full_name" value="<%= values.full_name || '' %>" required maxlength="120"></div>
      <div><label for="username"><%= t('fields.username') %></label><input id="username" name="username" value="<%= values.username || '' %>" required pattern="[A-Za-z0-9._\-]{3,40}" autocapitalize="none"><p class="help"><%= t('admin.usernameFormat') %></p></div>
      <div><label for="role"><%= t('fields.role') %></label><select id="role" name="role"><% ['teacher','parent','admin','bursar'].forEach(function (r) { %><option value="<%= r %>" <%= values.role === r ? 'selected' : '' %>><%= t('roles.' + r) %></option><% }) %></select></div>
      <div><label for="phone"><%= t('fields.phone') %> <span class="help-inline">(<%= t('common.optional') %>)</span></label><input id="phone" name="phone" type="tel" value="<%= values.phone || '' %>" placeholder="+237 6XX XX XX XX"></div>
      <div><label for="email"><%= t('fields.email') %> <span class="help-inline">(<%= t('common.optional') %>)</span></label><input id="email" name="email" type="email" value="<%= values.email || '' %>"><p class="help"><%= t('admin.emailHelp') %></p></div>
      <div><label for="language"><%= t('fields.language') %></label><select id="language" name="language"><option value="fr">Français</option><option value="en" <%= values.language === 'en' ? 'selected' : '' %>>English</option></select></div>
    </div>
    <button class="btn btn-primary"><%= t('admin.createAccount') %></button>
  </form>
</section>
<%- include('../partials/foot') %>
