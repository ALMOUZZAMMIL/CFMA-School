<%- include('../partials/head') %>
<div class="page-head"><h1><%= u.full_name %></h1><a class="btn" href="/admin/users"><%= t('common.back') %></a></div>
<% if (reset) { %>
<div class="alert alert-ok credentials" role="status"><p><strong><%= t('admin.passwordReset') %></strong></p>
  <p><%= t('fields.username') %>: <code><%= u.username %></code> · <%= t('admin.tempPassword') %>: <code><%= reset %></code></p><p class="small"><%= t('admin.tempPasswordHelp') %></p></div>
<% } %>
<section class="card">
  <p class="muted"><%= t('roles.' + u.role) %> · <%= t('fields.username') %>: <%= u.username %> · <%= t('admin.lastLogin') %>: <%= u.last_login_at ? fmt.dateTime(u.last_login_at) : '—' %></p>
  <form method="post" action="/admin/users/<%= u.id %>" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid-2">
      <div><label for="full_name"><%= t('fields.full_name') %></label><input id="full_name" name="full_name" value="<%= u.full_name %>" required maxlength="120"></div>
      <div><label for="phone"><%= t('fields.phone') %></label><input id="phone" name="phone" type="tel" value="<%= u.phone || '' %>"></div>
      <div><label for="email"><%= t('fields.email') %></label><input id="email" name="email" type="email" value="<%= u.email || '' %>"><p class="help"><%= t('admin.emailHelp') %></p></div>
      <div><label for="language"><%= t('fields.language') %></label><select id="language" name="language"><option value="fr">Français</option><option value="en" <%= u.language === 'en' ? 'selected' : '' %>>English</option></select></div>
      <div><label class="check"><input type="checkbox" name="active" value="1" <%= u.active ? 'checked' : '' %>> <%= t('admin.accountActive') %></label><p class="help"><%= t('admin.deactivateHelp') %></p></div>
    </div>
    <button class="btn btn-primary"><%= t('common.save') %></button>
  </form>
</section>
<section class="card">
  <h2><%= t('admin.resetPassword') %></h2><p class="help"><%= t('admin.resetHelp') %></p>
  <form method="post" action="/admin/users/<%= u.id %>/reset-password" data-confirm="<%= t('admin.confirmReset') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn"><%= t('admin.resetPassword') %></button></form>
</section>
<% if (u.role === 'parent') { %>
<section class="card"><h2><%= t('admin.linkedChildren') %></h2>
  <% if (!children.length) { %><p class="muted"><%= t('admin.noLinkedChildren') %></p><% } else { %>
  <ul class="list"><% children.forEach(function (c) { %><li><a href="/admin/students/<%= c.id %>"><%= c.full_name %></a><%= c.relationship ? ' (' + c.relationship + ')' : '' %></li><% }) %></ul><% } %>
  <p class="help"><%= t('admin.linkFromStudent') %></p></section>
<% } %>
<%- include('../partials/foot') %>
