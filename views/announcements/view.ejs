<%- include('../partials/head') %>
<% var title = lang === 'en' ? (a.title_en || a.title_fr) : (a.title_fr || a.title_en); var body = lang === 'en' ? (a.body_en || a.body_fr) : (a.body_fr || a.body_en); %>
<article class="card announcement">
  <div class="small"><span class="tag"><%= t('announcements.cat.' + a.category) %></span> <%= fmt.dateTime(a.publish_at) %> · <%= a.class_name || t('announcements.wholeSchool') %></div>
  <h1><%= title %></h1>
  <p class="pre"><%= body %></p>
  <% if (a.expires_at) { %><p class="small muted"><%= t('announcements.visibleUntil', { date: fmt.dateTime(a.expires_at) }) %></p><% } %>
  <p class="no-print"><button class="btn" data-print><%= t('common.print') %></button> <a class="btn" href="/announcements"><%= t('common.back') %></a></p>
</article>
<%- include('../partials/foot') %>
