<!doctype html>
<html lang="<%= lang %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= plan.title %></title><link rel="stylesheet" href="/static/style.css">
<link rel="stylesheet" href="/brand.css"><script src="/static/app.js" defer></script></head>
<body class="print-page">
<div class="no-print print-bar"><a class="btn" href="/plans/<%= plan.id %>"><%= t('common.back') %></a> <button class="btn btn-primary" data-print><%= t('common.print') %></button></div>
<h1><%= settings.school_name %> — <%= plan.title %></h1>
<p><%= ln(plan, 'section') %> · <%= plan.level %> · <%= ln(plan, 'subject') %></p>
<table class="register">
  <thead><tr><th>#</th><th><%= t('fields.lesson_id') %></th><th><%= t('common.term') %></th><th><%= t('plans.plannedDate') %></th><th><%= t('plans.hours') %></th><th><%= t('plans.doneOn') %></th></tr></thead>
  <tbody><% chapters.forEach(function (ch) { %>
    <tr class="chapter-row"><td colspan="6"><strong><%= ch.ordinal %>. <%= ch.title %></strong></td></tr>
    <% ch.lessons.forEach(function (l) { %><tr><td><%= ch.ordinal %>.<%= l.ordinal %></td><td><%= l.title %></td><td><%= ch.term_name || '' %></td><td><%= l.planned_date ? fmt.date(l.planned_date) : '' %></td><td><%= l.planned_hours === null ? '' : fmt.number(l.planned_hours) %></td><td class="cell"></td></tr><% }) %>
  <% }) %></tbody>
</table>
</body></html>
