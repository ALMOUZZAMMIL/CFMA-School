<%- include('../partials/head') %>
<div class="page-head"><h1><%= t('plans.title') %></h1></div>
<p class="help"><%= t('plans.intro') %></p>
<% if (user.role === 'admin' && pendingRequests) { %>
<p class="notice"><span aria-hidden="true">◷</span> <%= t('plans.req.waiting', { n: pendingRequests }) %> <a class="btn btn-primary btn-small" href="/plans/requests"><%= t('plans.req.review') %></a></p>
<% } else if (user.role === 'admin') { %><p><a href="/plans/requests"><%= t('plans.requestsTitle') %></a></p><% } %>
<% if (user.role === 'teacher' && windowsLimited) { %>
  <% if (openTerms.length) { %><p class="notice notice-ok">✎ <%= t('plans.win.openUntil', { terms: openTerms.map(function (x) { return x.name; }).join(', '), date: fmt.date(openTerms[0].plan_window_end) }) %></p>
  <% } else { %><p class="notice"><%= t('plans.win.closedList') %></p><% } %>
<% } %>
<% if (user.role === 'teacher') { %>
<section class="card" id="mine">
  <div class="card-head"><h2><%= t('plans.mine.title') %></h2></div>
  <p class="help"><%= t('plans.mine.help') %></p>
  <%- include('../partials/errors', { errors }) %>
  <% if (!mine.length) { %><p class="muted"><%= t('plans.mine.none') %></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th><%= t('fields.level') %></th><th><%= t('common.subject') %></th><th><%= t('plans.lessons') %></th><th><%= t('progress.status') %></th><th></th></tr></thead>
    <tbody><% mine.forEach(function (m) { %>
      <tr><td><%= m.level %> <span class="small muted"><%= ln(m, 'section') %></span></td><td><%= ln(m, 'subject') %></td><td><%= m.plan_id ? m.lessons : '—' %></td>
        <td><%- include('sheet-status', { status: m.plan_id ? m.status : null, windowOpen: m.windowOpen, pending: m.pending }) %></td>
        <td><% if (m.plan_id) { %><a href="/plans/<%= m.plan_id %>"><%= t('common.open') %></a><% } else if (windowsLimited && !openTerms.length) { %><span class="small muted"><%= t('plans.win.waitWindow') %></span><% } else { %>
          <form method="post" action="/plans" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="section_id" value="<%= m.section_id %>"><input type="hidden" name="level" value="<%= m.level %>"><input type="hidden" name="subject_id" value="<%= m.subject_id %>">
            <button class="btn btn-primary btn-small"><%= t('plans.mine.start') %></button>
          </form><% } %></td></tr>
    <% }) %></tbody>
  </table></div>
  <% } %>
</section>
<% } %>
<form method="get" class="filters"><label><%= t('fields.section_id') %><select name="section"><option value=""><%= t('common.all') %></option><% sections.forEach(function (s) { %><option value="<%= s.id %>" <%= s.id === sectionId ? 'selected' : '' %>><%= ln(s) %></option><% }) %></select></label><button class="btn"><%= t('common.show') %></button></form>
<% if (!rows.length) { %><div class="empty"><p><%= t('plans.empty') %></p></div><% } else { %>
<% groups.forEach(function (g) { %>
<section class="card plan-section">
  <h2><%= ln(g, 'section') %></h2>
  <% g.cycles.forEach(function (c) { %>
  <h3 class="plan-cycle"><%= t(c.cycle === 1 ? 'plans.cycle1' : 'plans.cycle2') %></h3>
  <div class="plan-classes">
  <% c.classes.forEach(function (k) { %>
    <details class="plan-class">
      <summary><strong><%= k.level %></strong> <span class="help-inline"><%= t('plans.subjectCount', { n: k.items.length }) %></span></summary>
      <div class="table-wrap"><table>
        <thead><tr><th><%= t('common.subject') %></th><th><%= t('plans.chapters') %></th><th><%= t('plans.lessons') %></th><th><%= t('progress.status') %></th><th></th></tr></thead>
        <tbody><% k.items.forEach(function (p) { %><tr><td><%= ln(p, 'subject') %></td><td><%= p.chapters %></td><td><%= p.lessons %></td><td><%- include('sheet-status', { status: p.status, windowOpen: p.edit_until && p.edit_until > lockNow, pending: 0 }) %></td><td><a href="/plans/<%= p.id %>"><%= t('common.open') %></a></td></tr><% }) %></tbody>
      </table></div>
    </details>
  <% }) %>
  </div>
  <% }) %>
</section>
<% }) %>
<% } %>
<% if (user.role === 'admin') { %>
<section class="card" id="windows">
  <h2><%= t('plans.win.title') %></h2>
  <p class="help"><%= t('plans.win.help') %></p>
  <form method="post" action="/plans/windows" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="table-wrap"><table>
      <thead><tr><th><%= t('common.term') %></th><th><%= t('plans.win.opens') %></th><th><%= t('plans.win.closes') %></th><th><%= t('progress.status') %></th></tr></thead>
      <tbody><% terms.forEach(function (tm) { var on = tm.plan_window_start && tm.plan_window_start <= today && tm.plan_window_end >= today; %>
        <tr><td><%= tm.name %> <span class="small muted"><%= fmt.date(tm.start_date) %> – <%= fmt.date(tm.end_date) %></span></td>
          <td><input type="date" name="start_<%= tm.id %>" value="<%= tm.plan_window_start || '' %>" aria-label="<%= t('plans.win.opens') %> <%= tm.name %>"></td>
          <td><input type="date" name="end_<%= tm.id %>" value="<%= tm.plan_window_end || '' %>" aria-label="<%= t('plans.win.closes') %> <%= tm.name %>"></td>
          <td><% if (on) { %><span class="badge badge-in_progress">✎ <%= t('plans.win.isOpen') %></span><% } else if (tm.plan_window_start && tm.plan_window_end < today) { %><span class="badge badge-none"><%= t('plans.win.isPast') %></span><% } else if (tm.plan_window_start) { %><span class="badge badge-planned"><%= t('plans.win.isSoon') %></span><% } else { %><span class="small muted">—</span><% } %></td></tr>
      <% }) %></tbody>
    </table></div>
    <button class="btn btn-primary"><%= t('common.save') %></button>
  </form>
</section>
<% } %>
<% if (user.role === 'admin') { %>
<section class="card" id="new">
  <h2><%= t('plans.new') %></h2>
  <%- include('../partials/errors', { errors }) %>
  <form method="post" action="/plans" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid-3">
      <div><label for="section_id"><%= t('fields.section_id') %></label><select id="section_id" name="section_id" required><% sections.forEach(function (s) { %><option value="<%= s.id %>" <%= values.section_id === s.id ? 'selected' : '' %>><%= ln(s) %></option><% }) %></select></div>
      <div><label for="level"><%= t('fields.level') %></label><input id="level" name="level" list="levels" value="<%= values.level || '' %>" required><datalist id="levels"><% levels.forEach(function (l) { %><option value="<%= l.level %>"><% }) %></datalist></div>
      <div><label for="subject_id"><%= t('common.subject') %></label><select id="subject_id" name="subject_id" required><% subjects.forEach(function (s) { %><option value="<%= s.id %>" <%= values.subject_id === s.id ? 'selected' : '' %>><%= ln(s) %></option><% }) %></select></div>
    </div>
    <p class="help"><%= t('plans.levelHelp') %></p>
    <label for="title"><%= t('fields.title') %> <span class="help-inline">(<%= t('common.optional') %>)</span></label><input id="title" name="title" value="<%= values.title || '' %>" maxlength="200">
    <button class="btn btn-primary"><%= t('plans.create') %></button>
  </form>
</section>
<% } %>
<%- include('../partials/foot') %>
