<section class="card">
  <div class="card-head"><h2><%= t('announcements.latest') %></h2><a href="/announcements"><%= t('common.seeAll') %></a></div>
  <% if (!announcements.length) { %><p class="muted"><%= t('announcements.empty') %></p><% } else { %>
  <ul class="notice-list">
    <% announcements.forEach(function (a, i) { %>
    <li>
      <span class="notice-icon notice-tone-<%= (i % 4) + 1 %>" aria-hidden="true"><%- include('icon', { name: 'megaphone' }) %></span>
      <span class="notice-main"><a href="/announcements/<%= a.id %>"><%= (lang === 'en' ? (a.title_en || a.title_fr) : (a.title_fr || a.title_en)) %></a><small><%= t('announcements.cat.' + a.category) %><% if (a.class_name) { %> · <%= a.class_name %><% } %></small></span>
      <span class="date-pill"><%= fmt.dateTime(a.publish_at) %></span>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
