<% var menu = (typeof nav !== "undefined" && nav) || null; %>
<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' · ' : '' %><%= settings.school_name %></title>
<link rel="preload" href="/static/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/style.css?v=<%= assetV %>">
<link rel="stylesheet" href="/brand.css">
<script src="/static/app.js?v=<%= assetV %>" defer></script>
</head>
<body class="portal<%= menu ? ' has-nav' : '' %><%= menu && menu.tabs.length ? ' has-tabs' : '' %>" data-confirm-ok="<%= t('common.confirm') %>" data-confirm-cancel="<%= t('common.cancel') %>">
<a class="skip" href="#main"><%= t('common.skipToContent') %></a>
<div class="shell">
<% if (menu) { %>
  <nav id="menu" class="sidebar" aria-label="<%= t('nav.main') %>">
    <div class="sb-head">
      <a class="sb-brand" href="/"><%- include('mark', { size: 'sm' }) %><span><strong><%= settings.school_name %></strong><% if (year) { %><small><%= t('common.year') %> <%= year.name %></small><% } %></span></a>
      <a class="sb-close iconbtn" href="#" aria-label="<%= t('nav.closeMenu') %>"><%- include('icon', { name: 'close' }) %></a>
    </div>
    <div class="sb-scroll">
    <% menu.groups.forEach(function (g) { %>
      <% if (g.title) { %><p class="sb-group"><%= t(g.title) %></p><% } %>
      <ul class="sb-list">
      <% g.items.forEach(function (i) { %>
        <li><a class="sb-item<%= i.active ? ' on' : '' %>" href="<%= i.href %>"<% if (i.active) { %> aria-current="page"<% } %>><%- include('icon', { name: i.icon }) %><span class="sb-label"><%= t(i.key) %></span><% if (i.count) { %><span class="count"><%= i.count %><span class="sr"> <%= t('common.unread') %></span></span><% } %></a></li>
      <% }) %>
      </ul>
    <% }) %>
    </div>
    <div class="sb-foot">
      <span class="avatar" aria-hidden="true"><%= user.full_name.split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0]; }).join('').toUpperCase() %></span>
      <span class="sb-me"><strong><%= user.full_name %></strong><small><%= t('roles.' + user.role) %></small></span>
    </div>
  </nav>
  <a class="sb-backdrop" href="#" tabindex="-1" aria-hidden="true"></a>
<% } %>
<div class="shell-main">
<% if (settings.demo_mode === '1') { %>
  <details class="demo-strip" role="note"><summary><%- include('icon', { name: 'info', cls: 'ico-sm' }) %><span><%= t('common.demoShort') %></span></summary><p><%= t('common.demoBanner') %></p></details>
<% } %>
<header class="topbar">
  <% if (menu) { %><a class="iconbtn menu-btn" href="#menu" aria-label="<%= t('nav.openMenu') %>" aria-controls="menu"><%- include('icon', { name: 'menu' }) %></a><% } %>
  <a class="tb-brand" href="/"><%- include('mark', { size: 'sm' }) %><span><%= settings.school_name %></span></a>
  <span class="tb-spacer"></span>
  <form method="post" action="/lang" class="seg" aria-label="<%= t('site.language') %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="back" value="<%= originalUrl %>">
    <button name="lang" value="fr" class="<%= lang === 'fr' ? 'on' : '' %>" aria-pressed="<%= lang === 'fr' %>" lang="fr" title="Français">FR</button>
    <button name="lang" value="en" class="<%= lang === 'en' ? 'on' : '' %>" aria-pressed="<%= lang === 'en' %>" lang="en" title="English">EN</button>
  </form>
  <% if (user) { %>
  <details class="account">
    <summary class="iconbtn" aria-label="<%= t('nav.account') %>"><%- include('icon', { name: 'user' }) %></summary>
    <div class="account-menu">
      <p class="account-who"><strong><%= user.full_name %></strong><small><%= t('roles.' + user.role) %></small></p>
      <a href="/account/password"><%- include('icon', { name: 'key', cls: 'ico-sm' }) %><%= t('auth.changePassword') %></a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit"><%- include('icon', { name: 'logout', cls: 'ico-sm' }) %><%= t('auth.logout') %></button></form>
    </div>
  </details>
  <% } %>
</header>
<div id="net-status" class="net-status" hidden role="status"><%= t('common.offline') %></div>
<% if (user) { %>
<div id="session-warning" class="net-status session-warning" hidden role="alert" data-user="<%= user.id %>">
  <span data-session-msg="warning"><%= t('idle.warning') %></span>
  <span data-session-msg="ended" hidden><%= t('idle.ended') %></span>
  <span data-session-msg="restored" hidden><%= t('idle.restored') %></span>
  <button type="button" class="btn btn-small" data-session-action="stay"><%= t('idle.stay') %></button>
  <a class="btn btn-small" href="/login" target="_blank" rel="noopener" data-session-action="signin" hidden><%= t('idle.signIn') %></a>
</div>
<% } %>
<main id="main" class="container">
<% if (flash) { %>
  <div class="alert alert-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
    <span class="alert-icon" aria-hidden="true"><%= flash.type === 'ok' ? '✓' : flash.type === 'error' ? '!' : 'i' %></span> <%= flash.message %>
  </div>
<% } %>
