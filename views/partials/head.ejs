<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' · ' : '' %><%= settings.school_name %></title>
<link rel="stylesheet" href="/static/style.css">
<link rel="stylesheet" href="/brand.css">
<script src="/static/app.js" defer></script>
</head>
<body>
<a class="skip" href="#main"><%= t('common.skipToContent') %></a>
<% if (settings.demo_mode === '1') { %>
<div class="demo-banner" role="note"><%= t('common.demoBanner') %></div>
<% } %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/"><%- include("mark", { size: "sm" }) %> <span><%= settings.school_name %></span></a>
    <form method="post" action="/lang" class="lang-switch">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="back" value="<%= originalUrl %>">
      <button name="lang" value="en" class="<%= lang === 'en' ? 'on' : '' %>" aria-pressed="<%= lang === 'en' %>" lang="en">English</button>
      <button name="lang" value="fr" class="<%= lang === 'fr' ? 'on' : '' %>" aria-pressed="<%= lang === 'fr' %>" lang="fr">Français</button>
    </form>
  </div>
  <% if (user && !user.must_change_password) { %>
  <nav class="mainnav" aria-label="<%= t('nav.main') %>">
    <a href="/" class="<%= path === '/' ? 'active' : '' %>"><%= t('nav.dashboard') %></a>
    <% if (user.role === 'teacher' || user.role === 'admin') { %>
      <a href="/teaching" class="<%= path.startsWith('/teaching') || path.startsWith('/sessions') ? 'active' : '' %>"><%= t('nav.teaching') %></a>
      <a href="/attendance" class="<%= path.startsWith('/attendance') ? 'active' : '' %>"><%= t('nav.attendance') %></a>
      <a href="/progress" class="<%= path.startsWith('/progress') ? 'active' : '' %>"><%= t('nav.progress') %></a>
      <a href="/plans" class="<%= path.startsWith('/plans') ? 'active' : '' %>"><%= t('nav.plans') %></a>
      <a href="/reports/hours" class="<%= path.startsWith('/reports') ? 'active' : '' %>"><%= t('nav.reports') %></a>
    <% } %>
    <% if (user.role !== 'bursar' && user.role !== 'admin') { %>
      <a href="/timetable" class="<%= path.startsWith('/timetable') ? 'active' : '' %>"><%= t('nav.timetable') %></a>
    <% } %>
    <% if (user.role === 'student') { %>
      <a href="/me" class="<%= path.startsWith('/students') ? 'active' : '' %>"><%= t('nav.myRecord') %></a>
    <% } %>
    <% if (user.role !== 'bursar') { %>
      <a href="/announcements" class="<%= path.startsWith('/announcements') ? 'active' : '' %>"><%= t('nav.announcements') %></a>
    <% } %>
    <% if (user.role === 'parent') { %>
      <a href="/notifications" class="<%= path.startsWith('/notifications') ? 'active' : '' %>"><%= t('nav.notifications') %><% if (unread) { %> <span class="count"><%= unread %><span class="sr"> <%= t('common.unread') %></span></span><% } %></a>
    <% } %>
    <% if (user.role === 'admin') { %>
      <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>"><%= t('nav.admin') %></a>
    <% } %>
    <span class="nav-user">
      <span class="who"><%= user.full_name %> · <%= t('roles.' + user.role) %></span>
      <a href="/account/password"><%= t('auth.changePassword') %></a>
      <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn"><%= t('auth.logout') %></button></form>
    </span>
  </nav>
  <% } %>
</header>
<div id="net-status" class="net-status" hidden role="status"><%= t('common.offline') %></div>
<main id="main" class="container">
<% if (flash) { %>
  <div class="alert alert-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
    <span class="alert-icon" aria-hidden="true"><%= flash.type === 'ok' ? '✓' : flash.type === 'error' ? '!' : 'i' %></span> <%= flash.message %>
  </div>
<% } %>
